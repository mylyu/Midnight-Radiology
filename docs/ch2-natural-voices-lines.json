      "id": "vox_ch2_natural_zhou",
      "old_spoken": "新机器，新规矩，今晚你拍，我看着。",
      "text": "有事叫我。",
      "reference": "selected:zhou",
      "seconds": 1.5,
      "direction": "松弛随口，像同事之间交接，不故作意味深长。"
    },
