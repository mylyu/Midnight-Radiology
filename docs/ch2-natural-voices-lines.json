      "old_id": "vox2_fan_b",
      "id": "vox_ch2_natural_fan_b",
      "old_spoken": "原厂货，撑到了最后一天。",
      "text": "这台先留着吧。",
      "reference": "game:vox_fan",
      "seconds": 1.9,
      "direction": "谈旧设备去留的平常语气，不打品牌广告。"
    },
