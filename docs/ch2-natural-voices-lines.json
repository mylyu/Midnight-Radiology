      "id": "vox_ch2_natural_kai",
      "old_spoken": "日检、预热，别偷懒。",
      "text": "有事打我电话。",
      "reference": "game:vox_kai",
      "seconds": 1.9,
      "direction": "工程师交代联系方式，平等、随和，不训人、不喊口令。"
    },
