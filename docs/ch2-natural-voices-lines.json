      "id": "vox_ch2_natural_fan_a",
      "old_spoken": "第三天中午，球管就烧了。",
      "text": "才三天，就坏了。",
      "reference": "game:vox_fan",
      "seconds": 2,
      "direction": "普通抱怨，略无奈，不卖惨。"
    },
