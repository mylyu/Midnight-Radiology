      "step": "c2n1_2",
      "old_id": "vox2_tang",
      "id": "vox_ch2_natural_tang",
      "old_spoken": "我可什么都没说啊！",
      "text": "哎，你来啦。",
      "reference": "game:vox_tang",
      "seconds": 1.6,
      "direction": "认出熟人的随口招呼，轻快但不咋呼、不撒娇。"
    },
    {
