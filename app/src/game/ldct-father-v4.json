    "next": "lf_dinner_2"
  },
  "lf_dinner_2": {
    "id": "lf_dinner_2",
    "bg": "bg_breakroom",
    "sprite": "@luzhou",
    "speaker": "me",
    "text": "叔叔惦记的哪是饭钱。先吃两口，咱再看。",
