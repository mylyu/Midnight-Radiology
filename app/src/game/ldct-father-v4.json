  "lf_after_filter_0": {
    "id": "lf_after_filter_0",
    "bg": "bg_breakroom",
    "sprite": "@luzhou",
    "speaker": "me",
    "text": "锐的边上利索，柔的看着舒服。光问哪张“清楚”，还真说不准。",
